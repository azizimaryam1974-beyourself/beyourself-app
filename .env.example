# --- Allgemein ---------------------------------------------------------------
# Öffentliche Adresse (für Cookies/Links)
APP_URL=https://fahrschule-beyourself.de
# SQLite-Datei (im Docker-Container unter /app/data)
DATABASE_PATH=./data/beyourself.db

# Unterrichtsprotokolle nach so vielen Tagen löschen (nach Ende der Stunde)
LESSON_RETENTION_DAYS=180

# --- Sprachen ----------------------------------------------------------------
# Farsi ist vorbereitet. Auf 1 setzen, um es bei der Anmeldung anzubieten.
ENABLE_FARSI=0

# --- Übersetzung -------------------------------------------------------------
# "claude" (empfohlen: Claude übersetzt, Azure als Reserve),
# "azure" (nur Azure Translator) oder "mock" (Test ohne Konten)
TRANSLATION_PROVIDER=mock
# Claude (Anthropic API) – Schlüssel von https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
# Azure Speech (Spracherkennung + Vorlesestimme), Region in Deutschland
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=germanywestcentral
# Azure Translator (Textübersetzung), EU-Endpunkt
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=germanywestcentral
AZURE_TRANSLATOR_ENDPOINT=https://api-eur.cognitive.microsofttranslator.com

# --- Online-Zahlung ------------------------------------------------------------
# Stripe (Karte, Apple Pay, Google Pay; Klarna wenn im Stripe-Konto aktiv)
# Zum Testen die "sk_test_…"-Schlüssel, für echte Zahlungen "sk_live_…".
STRIPE_SECRET_KEY=
# Webhook-Geheimnis (whsec_…) für https://fahrschule-beyourself.de/api/zahlung/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Zahlarten stellt man im Stripe-Dashboard ein (Einstellungen → Zahlungsmethoden).
# Nur Sofort-Zahlarten einschalten (Karte, Apple Pay, Google Pay) – KEINE Lastschrift/SEPA, das dauert Tage.
# Optional: bestimmte Konfiguration (pmc_…)
STRIPE_PAYMENT_METHOD_CONFIG=
# PayPal (developer.paypal.com → Apps & Credentials)
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
# "sandbox" zum Testen, "live" für echte Zahlungen
PAYPAL_ENV=sandbox
# 1 = Test-Zahlung ohne echtes Geld (nur zum Ausprobieren, vor dem Start auf 0!)
PAYMENTS_TEST_MODE=0

# --- E-Mail (IONOS-Postfach info@fahrschule-beyourself.de) ----------------------
SMTP_HOST=smtp.ionos.de
SMTP_PORT=587
SMTP_USER=info@fahrschule-beyourself.de
SMTP_PASS=
MAIL_FROM=Fahrschule beyourself <info@fahrschule-beyourself.de>
# Hierhin gehen Hinweise zu neuen Anfragen und Zahlungen
ADMIN_EMAIL=info@fahrschule-beyourself.de
