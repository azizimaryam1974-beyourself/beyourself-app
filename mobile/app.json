{
  "expo": {
    "name": "beyourself Fahrschule",
    "slug": "fahrschule-be-yourself",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "beyourself",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "de.fahrschulebeyourself.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "NSCameraUsageDescription": "Damit du Ausweis, Sehtest oder Belege direkt mit der Kamera fotografieren und hochladen kannst.",
        "NSPhotoLibraryUsageDescription": "Damit du Fotos (z. B. Ausweis, Belege, Profilfoto) aus deinen Bildern hochladen kannst.",
        "NSMicrophoneUsageDescription": "Für den Live-Theorieunterricht: Die Fahrlehrerin spricht, die App übersetzt live.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F1A2C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "de.fahrschulebeyourself.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F1A2C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-audio",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#C6A465",
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "beyourself-fahrschule",
    "extra": {
      "eas": {
        "projectId": "f9fa8c4e-75b1-4181-939c-96cffff11d4a"
      }
    }
  }
}